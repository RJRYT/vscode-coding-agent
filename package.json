{
  "name": "nemotron-coding-agent",
  "displayName": "Nemotron Coding Agent",
  "description": "A workspace-aware coding agent powered by NVIDIA Nemotron. Review and approve file edits and terminal commands.",
  "version": "0.2.17",
  "icon": "media/extension-icon.png",
  "publisher": "rjryt",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/RJRYT/vscode-coding-agent"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "nvidia",
    "nemotron",
    "coding-agent",
    "agent",
    "chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:nemotronAgent.chatView",
    "onCommand:nemotronAgent.setApiKey",
    "onCommand:nemotronAgent.newChat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nemotronAgent",
          "title": "Nemotron Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nemotronAgent": [
        {
          "type": "webview",
          "id": "nemotronAgent.chatView",
          "name": "Coding Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "nemotronAgent.setApiKey",
        "title": "Nemotron Agent: Set NVIDIA API Key"
      },
      {
        "command": "nemotronAgent.clearApiKey",
        "title": "Nemotron Agent: Clear NVIDIA API Key"
      },
      {
        "command": "nemotronAgent.newChat",
        "title": "Nemotron Agent: New Chat"
      },
      {
        "command": "nemotronAgent.focus",
        "title": "Nemotron Agent: Focus Chat"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nemotronAgent.newChat",
          "when": "view == nemotronAgent.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Nemotron Agent",
      "properties": {
        "nemotronAgent.model": {
          "type": "string",
          "default": "nvidia/nemotron-3.5-super-vl-120b-a12b",
          "description": "NVIDIA NIM model ID."
        },
        "nemotronAgent.baseUrl": {
          "type": "string",
          "default": "https://integrate.api.nvidia.com/v1",
          "description": "OpenAI-compatible API base URL."
        },
        "nemotronAgent.maxTokens": {
          "type": "integer",
          "default": 16384,
          "minimum": 1024,
          "maximum": 65536,
          "description": "Maximum output tokens per model turn. Reasoning tokens are included."
        },
        "nemotronAgent.reasoning": {
          "type": "boolean",
          "default": true,
          "description": "Enable Nemotron thinking/reasoning."
        },
        "nemotronAgent.maxToolRounds": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum consecutive model tool-calling rounds per user request. There is no separate individual tool-call cap."
        },
        "nemotronAgent.persona": {
          "type": "string",
          "default": "helpful coding assistant",
          "description": "Persona that guides how Nemotron behaves."
        },
        "nemotronAgent.tone": {
          "type": "string",
          "default": "",
          "description": "Preferred tone for responses (e.g. concise, detailed)."
        },
        "nemotronAgent.expertise": {
          "type": "array",
          "default": [],
          "description": "Areas of expertise used for personalization.",
          "items": {
            "type": "string"
          }
        },
        "nemotronAgent.responseLanguage": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "English",
            "Malayalam",
            "Hindi"
          ],
          "description": "Preferred language for explanations and conversation."
        },
        "nemotronAgent.codeStyle": {
          "type": "string",
          "default": "follow project conventions",
          "enum": [
            "follow project conventions",
            "minimal focused changes",
            "TypeScript-first",
            "JavaScript-first"
          ],
          "description": "Preferred coding style when it does not conflict with the existing project."
        },
        "nemotronAgent.memoryEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Remember facts across chats in this workspace."
        },
        "nemotronAgent.autoSaveChats": {
          "type": "boolean",
          "default": true,
          "description": "Save conversation history to this workspace so you can return to earlier chats."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/copy-resources.cjs",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.3",
    "@vscode/vsce": "^3.2.1",
    "vitest": "^2.0.5",
    "jsdom": "^24.1.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace browsing is available, but file edits and shell commands require a trusted workspace."
    }
  }
}
